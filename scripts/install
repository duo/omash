#!/usr/bin/env bash

set -euo pipefail

repository=https://github.com/duo/omash
install_branch=main
build_root=$(mktemp -d -t omash-install.XXXXXXXX)

cleanup() {
  rm -rf -- "$build_root"
}
trap cleanup EXIT

omarchy=false
if command -v omarchy >/dev/null 2>&1; then
  omarchy=true
fi

for command in cargo curl tar install sed stat systemctl; do
  if ! command -v "$command" >/dev/null 2>&1; then
    echo "$command is required to install omash." >&2
    if [[ $command == cargo ]]; then
      if $omarchy; then
        echo "Install it first with: omarchy install dev-env rust" >&2
      else
        echo "Install Rust first with rustup: https://rustup.rs" >&2
      fi
    fi
    exit 1
  fi
done

# omash's data directory, which the core runs in: like the dirs crate, only an absolute
# XDG_DATA_HOME counts.
data_home=${XDG_DATA_HOME:-}
[[ $data_home == /* ]] || data_home=$HOME/.local/share
data_dir=$data_home/omash

# The entry of a directory that Mihomo takes as its GeoIP database, as omash finds it before
# starting the core (geoip_candidates in src/core.rs): the first name, in byte order, that is
# Country.mmdb, geoip.db or geoip.metadb in any case, leaving out directories (but not links to
# them) and dangling links, which omash removes.
first_geoip_candidate() {
  local LC_ALL=C entry name
  for entry in "$1"/*; do
    name=${entry##*/}
    case ${name,,} in
      country.mmdb | geoip.db | geoip.metadb) ;;
      *) continue ;;
    esac
    [[ -d $entry && ! -L $entry ]] && continue
    is_dangling_link "$entry" && continue
    printf '%s\n' "$entry"
    return 0
  done
  return 1
}

# A link whose target does not exist (ENOENT), as is_dangling_link in src/core.rs decides. A
# target that cannot be looked up for another reason, such as a loop or a directory without
# search permission, leaves the link in place as an unusable database.
is_dangling_link() {
  local error
  [[ -L $1 ]] || return 1
  error=$(LC_ALL=C stat -L -- "$1" 2>&1 >/dev/null) && return 1
  # GNU's stat ends with the error's description, while uutils' stat, Ubuntu's default, adds
  # " (os error 2)" after it.
  [[ $error == *": No such file or directory"* ]]
}

# A Country.mmdb, in any case, from a distribution package, which omash links into its data
# directory.
has_system_geoip_database() {
  local LC_ALL=C entry name
  for entry in /etc/mihomo/* /etc/clash/*; do
    name=${entry##*/}
    [[ ${name,,} == country.mmdb && -f $entry ]] && return 0
  done
  return 1
}

missing_mihomo=false
[[ -x /usr/bin/mihomo ]] || missing_mihomo=true
missing_geoip=false
if geoip_database=$(first_geoip_candidate "$data_dir"); then
  if [[ ! -f $geoip_database ]]; then
    echo "$geoip_database is not a GeoIP database file; remove or replace it." >&2
    exit 1
  fi
elif ! has_system_geoip_database; then
  missing_geoip=true
fi

if $missing_mihomo || $missing_geoip; then
  if $omarchy; then
    missing_packages=()
    $missing_mihomo && missing_packages+=(mihomo)
    $missing_geoip && missing_packages+=(clash-geoip)
    echo "Install the required system packages first:" >&2
    echo "  omarchy pkg aur add ${missing_packages[*]}" >&2
  else
    if $missing_mihomo; then
      echo "omash needs Mihomo at /usr/bin/mihomo: install your distribution's package, or a .deb or .rpm from https://github.com/MetaCubeX/mihomo/releases" >&2
    fi
    if $missing_geoip; then
      # Downloading beside the file and renaming it replaces a link instead of writing through it.
      printf -v download '%q' "$data_dir/Country.mmdb.download"
      printf -v database '%q' "$data_dir/Country.mmdb"
      echo "omash needs a GeoIP database. Download it with:" >&2
      echo "  curl -fL --create-dirs -o $download \\" >&2
      echo "    https://github.com/Loyalsoldier/geoip/releases/latest/download/Country.mmdb &&" >&2
      echo "    mv -f $download $database" >&2
    fi
  fi
  exit 1
fi

archive="$build_root/$install_branch.tar.gz"
curl -fsSL "$repository/archive/refs/heads/$install_branch.tar.gz" -o "$archive"
tar -xzf "$archive" -C "$build_root"
source_root="$build_root/omash-$install_branch"

cargo build --locked --release --manifest-path "$source_root/Cargo.toml"

binary_path="$HOME/.local/bin/omash"
service_path="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/omash-supervisor.service"

install -Dm755 "$source_root/target/release/omash" "$binary_path"
install -Dm644 "$source_root/systemd/omash-supervisor.service" "$service_path"
sed -i 's|^ExecStart=.*|ExecStart=%h/.local/bin/omash --daemon|' "$service_path"

systemctl --user daemon-reload
if [[ -f /etc/omash-tun.json ]] && ! "$binary_path" tun status --check-helper >/dev/null 2>&1; then
  echo "Installed the new client, but the current TUN helper could not confirm compatibility. Run omash tun setup to update it; setup then restarts the supervisor." >&2
else
  systemctl --user try-restart omash-supervisor.service
fi

echo "Installed omash from $repository ($install_branch) to $binary_path."
if [[ :$PATH: == *":$HOME/.local/bin:"* ]]; then
  echo "Run: omash"
else
  echo "Add $HOME/.local/bin to PATH, then run: omash"
fi
